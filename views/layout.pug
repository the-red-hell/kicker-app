doctype html

html
    head
      meta(charset='UTF-8')
      meta(name='viewport' content='width=device-width, initial-scale=1.0')
      meta(name='description' content='A web application for tracking and analyzing your kicker game statistics.')
      meta(http-equiv='X-UA-Compatible' content='ie=edge')
      
      link(rel='apple-touch-icon' sizes='180x180' href='/static/images/favicon/apple-touch-icon.png')
      link(rel='icon' type='image/png' sizes='32x32' href='/static/images/favicon/favicon-32x32.png')
      link(rel='icon' type='image/png' sizes='16x16' href='/static/images/favicon/favicon-16x16.png')
      link(rel='manifest' href='/static/images/favicon/site.webmanifest')
      
      title= title
      block css
        link(rel='stylesheet' type="text/css" href='/static/css/style.css')

    body
      block header
        header
          nav
            ul#icon-list
              li
                a(href=loggedIn ? "/dashboard" : "/")
                  img(src='/static/images/KickerAPP_Logo_tbbg.svg' alt='Home')#logo
              li#spacer
              li.log-in-out
                if !loggedIn
                  button(onclick="window.location.href='/auth/login';") Login
                else
                  button(onclick="window.location.href='/auth/logout';") Logout
              li
                a(href='/profile')
                  img(src='/static/images/Profile_Icon.png' alt='User')#profile

      main#page-content
        block content

      block footer
        footer
          p &copy; #{new Date().getFullYear()} Kicker-Tracking App
          a(href='/about-us') About us
          br
          a(href='https://github.com/paulhkz/kicker-app.git' target="_blank") View Source           
