doctype html
html
    head
      meta(charset='UTF-8')
      meta(name='viewport' content='width=device-width, initial-scale=1.0')
      meta(http-equiv='X-UA-Compatible' content='ie=edge')
      title= title
      link(rel='stylesheet' type="text/css" href='/static/css/style.css')
    body
      block header
        header#header
          nav
            ul
              li: a(href='/') Home
              if !loggedIn
                li: a(href='/auth/login') Login
              else
                li: a(href='/auth/logout') Logout

      block content
      block footer
        footer#footer
          p &copy; #{new Date().getFullYear()} Kicker-Tracking App
          a(href='https://github.com/the-red-hell/web-engineering-projekt' target="_blank") View Source