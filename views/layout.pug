doctype html

html
    head
      meta(charset='UTF-8')
      meta(name='viewport' content='width=device-width, initial-scale=1.0')
      meta(http-equiv='X-UA-Compatible' content='ie=edge')
      title= title
      link(rel='stylesheet' type="text/css" href='/static/css/style.css')

    body
      block header
        header#header
          nav
            ul(style='display: flex; align-items: center; justify-content: space-between; list-style: none; margin: 0; padding: 0; width: 100%;')
              li
              a(href='/')
                img(src='/static/images/KickerAPP_Logo_tbbg.svg' alt='Home' style='height: auto; height: 90px;')

              li(style='margin-left: auto;')
              if !loggedIn
                a(href='/')
                img(src='/static/images/Profile_Icon.png' alt='User' style='height: auto; height: 90px; border: 10px solid #ffffff00;')
              else
                a(href='/auth/logout') Logout

      block content

      block footer
        footer#footer
          p &copy; #{new Date().getFullYear()} Kicker-Tracking App
          a(href='https://github.com/the-red-hell/web-engineering-projekt' target="_blank") View Source