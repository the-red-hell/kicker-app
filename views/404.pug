extends layout

block append css
    link(rel="stylesheet", href="/static/css/404.css")

block content
    div.container
        h1 404 - Page not found
        p The page 
            b #{originalUrl}
            |  does not exist. Please check the URL or return to the homepage.

        if message
            .reason
                h2 Reason:
                p #{message}
        
        if loggedIn
            a(href='/dashboard') Back to Dashboard
        else 
            a(href='/') Back to Homepage
