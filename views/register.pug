extends layout 

block content
    h1 Register

    form(action="/api/auth/login" method="POST")#login-form

        div
            label(for="firstName") First Name:
            br
            input(type="text" name="firstName" required)#firstName
        br

        div
            label(for="lastName") Last Name:
            br
            input(type="text" name="lastName" required)#lastName
        br

        div
            label(for="email") Email:
            br
            input(type="email" name="email" required)#email
        br

        div
            label(for="username") Username:
            br
            input(type="text" name="username" required)#username
        br

        div
            label(for="password") Password:
            br
            input(type="password" name="password" required)#password
        br

        div
            label(for="confirmPassword") Confirm Password:
            br
            input(type="password" name="confirmPassword" required)#confirmPassword
        br

        div
            input(type="checkbox" name="terms" required)#terms
            label(for="terms") I agree to the 
            a(href="/terms") Terms and Conditions
        br

        button(type="submit") Register
        br

        p Already have an account? 
            a(href="/auth/login") Login here
        br
