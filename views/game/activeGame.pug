extends ../layout

block content
    script.
        window.TABLE_ID = "#{tableId}";
        window.TEAM = "#{team}";
        window.POSITION = "#{position}";
    script(type="module" src="/static/js/game.js")
    p Game, #{tableId}, #{team}, #{position}


    button#scoreGoal(type="button") Score Goal
    button#undoGoal(type="button") Undo Goal
