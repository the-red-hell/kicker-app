extends ../layout

block append css
    link(rel="stylesheet", href="/static/css/activeGame.css")

block content
    script.
        window.TABLE_ID = "#{tableId}";
        window.TEAM = "#{team}";
        window.POSITION = "#{position}";
    script(type="module" src="/static/js/activeGame.js")

    .container
        .game-container
            .score-container
                .score#score-black
                    span.team-name Black
                    span.goals /
                    .players#players-black
                        .player.offense ——
                        .player.defense ——
                .score#score-white
                    span.team-name White
                    span.goals /
                    .players#players-white
                        .player.offense ——
                        .player.defense ——
            
            .info-container
                p You are 
                    strong#isPlaying
                    |  on 
                    strong#tableName
                    | .
                    | Your are on team 
                    strong #{team}
                    |  and your position is 
                    strong #{position}
                    | .

            .controls-container
                button.control-buttons#score-goal(type="button") Score Goal
                button.control-buttons#undo-goal(type="button") Undo Goal
                
                #errorBox
    
    .popup
        .popup-content
            h2#popupMessage