extends layout

block append css
    link(rel='stylesheet' type="text/css" href='/static/css/home.css')
    link(rel='stylesheet' type="text/css" href='/static/css/statistics/leaderboard.css')

block content
    div.container
        div.hero-shot
            img(src='/static/images/hero_shot.png' alt='Hero Shot')

        .register
            a(href='/auth/register') Register now for free!
                
        include statistics/leaderboard.pug
        
        .leaderboard
            a(href='/auth/register') Join the Leaderboard now and compete with your friends!

        .what-we-can-container
            .what-we-can
                h2 Analyze your performance

            .what-we-can
                h2 Compete with your friends

            .what-we-can
                h2 Scan a QR-code to get started
            
            .what-we-can
                h2 Track your progress and see how you improve over time
                
        .what-others-say 
            h2 what others say about us
            .testimonials
                .testimonial-group
                    .testimonial
                        p.quote "this app has transformed the way i play foosball. the real-time stats and performance analysis have helped me improve my game significantly. highly recommended!"
