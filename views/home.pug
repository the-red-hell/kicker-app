extends layout

block append css
    link(rel='stylesheet' type="text/css" href='/static/css/home.css')
    link(rel='stylesheet' type="text/css" href='/static/css/statistics/leaderboard.css')

block content
    .container
        .hero-container
            .hero-text
                .text
                    span TRACK
                    br
                    |  YOUR
                    br
                    |  FOOSBALL
                    br
                    |  PERFORMANCE
            .hero-shot
                img(src='/static/images/hero_shot.png' alt='Hero Shot')

        .register
            button(onclick="window.location.href='/auth/register';") Register now for free!

        include statistics/leaderboard.pug

        .register
            button(onclick="window.location.href='/auth/register';") Get your name on the leaderboard!

        .our-offers-container
            h1 Our Offers:
            .what-we-can-container
                .what-we-can
                    span Analyze your performance

                .what-we-can
                    span Compete with your friends

                .what-we-can
                    span Scan a QR-code to get started
                
                .what-we-can
                    span Track your progress and see how you improve over time

        .register
            button(onclick="window.location.href='/auth/register';") Register now for free!

        .what-others-say 
            h1 What others say about us:
            .testimonials
                +testimonials
                +testimonials
                +testimonials
                        

mixin testimonials 
    .testimonial-group
        .testimonial
            p.quote "This app has transformed the way I play foosball. The real-time stats and performance analysis have helped me improve my game significantly. Highly recommended!"
            span - Alex M.
        .testimonial
            p.quote "I love how easy it is to track my progress and compete with friends. The leaderboard adds a fun competitive element that keeps me motivated to play more!"
            span - Jamie L.
        .testimonial
            p.quote "The user-friendly interface and insightful analytics make this app a must-have for any foosball enthusiast. It's like having a personal coach in your pocket!"
            span - Taylor S.
        .testimonial 
            p.quote "I was skeptical at first, but this app has exceeded my expectations. The QR-code scanning feature is a game-changer, making it so easy to get started and track my performance."
            span - Jordan R.
        .testimonial 
            p.quote "The community aspect of this app is fantastic. Competing with friends and seeing my progress over time has made playing foosball even more enjoyable!"
            span - Casey D.