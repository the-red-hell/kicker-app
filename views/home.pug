extends layout

block append css
    link(rel='stylesheet' type="text/css" href='/static/css/home.css')

block content
    div.container
        div
            img(src='/static/images/hero_shot.png' alt='Hero Shot').heroShot

        div.logIn
            a(href='/auth/login') Jetzt Anmelden
        
        div.leaderboard
            a(href='/login') Join the Leaderboard now and compete with your friends!

        div.callToAction
            div.callToActionButton
                a(href='/auth/login') Analysiere deine Spiele

            div.callToActionButton
                a(href='/auth/login') Vergleiche dich mit Freunden

            div.callToActionButton
                a(href='/auth/login') Besteige das Leaderboard