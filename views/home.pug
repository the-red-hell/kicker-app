extends layout

block append css
    link(rel='stylesheet' type="text/css" href='/static/css/home.css')
    link(rel='stylesheet' type="text/css" href='/static/css/statistics/leaderboard.css')

block content
    div.container
        div
            img(src='/static/images/hero_shot.png' alt='Hero Shot').hero-shot

        div.log-in
            a(href='/auth/login') Jetzt Anmelden
        
        div.leaderboard
            a(href='/auth/login') Join the Leaderboard now and compete with your friends!

        div.call-to-action
            div.call-to-action-button
                a(href='/auth/login') Analysiere deine Spiele

            div.call-to-action-button
                a(href='/auth/login') Vergleiche dich mit Freunden

            div.call-to-action-button
                a(href='/auth/login') Besteige das Leaderboard
                
        include statistics/leaderboard.pug